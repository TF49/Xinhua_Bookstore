            }
            .modal-actions {
                display: flex;
                gap: 15px;
            }
            .btn-primary, .btn-secondary {
                padding: 12px 24px;
                border: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s ease;
            }
            .btn-primary {
                background: linear-gradient(135deg, #c41e3a 0%, #8b0000 100%);
                color: white;
            }
            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(196, 30, 58, 0.3);
            }
            .btn-secondary {
                background: #f0f0f0;
                color: #2d3436;
            }
            .btn-secondary:hover {
                background: #e0e0e0;
            }
            @media (max-width: 600px) {
                .modal-body {
                    flex-direction: column;
                    align-items: center;
                }
            }
        `;
        document.head.appendChild(style);
        document.body.appendChild(modal);
        
        modal.querySelector('.modal-close').addEventListener('click', () => {
            modal.remove();
        });
        
        modal.querySelector('.modal-overlay').addEventListener('click', () => {
            modal.remove();
        });
        
        document.addEventListener('keydown', function closeOnEscape(e) {
            if (e.key === 'Escape') {
                modal.remove();
                document.removeEventListener('keydown', closeOnEscape);
            }
        });
    }
}

function initBookmarkInteraction() {
    const contentItems = document.querySelectorAll('.content_item');
    
    contentItems.forEach(item => {
        const bookmarkBtn = document.createElement('button');
        bookmarkBtn.className = 'bookmark-btn';
        bookmarkBtn.innerHTML = '鈾?;
        bookmarkBtn.title = '鏀惰棌';
        bookmarkBtn.style.cssText = `
            position: absolute;
            top: 10px;
            right: 10px;
            width: 32px;
            height: 32px;
            background: rgba(255, 255, 255, 0.9);
            border: none;
            border-radius: 50%;
            font-size: 16px;
            cursor: pointer;
            opacity: 0;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 5;
        `;
        
        item.appendChild(bookmarkBtn);
        
        item.addEventListener('mouseenter', function() {
            bookmarkBtn.style.opacity = '1';
            bookmarkBtn.style.transform = 'scale(1)';
        });
        
        item.addEventListener('mouseleave', function() {
            bookmarkBtn.style.opacity = '0';
            bookmarkBtn.style.transform = 'scale(0.5)';
        });
        
        bookmarkBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            if (this.innerHTML === '鈾?) {
                this.innerHTML = '鈾?;
                this.style.color = '#c41e3a';
                showBookmarkNotification('宸叉敹钘?);
            } else {
                this.innerHTML = '鈾?;
                this.style.color = '#636e72';
                showBookmarkNotification('宸插彇娑堟敹钘?);
            }
        });
    });
    
    function showBookmarkNotification(text) {
        const notification = document.createElement('div');
        notification.textContent = text;
        notification.style.cssText = `
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(45, 52, 54, 0.9);
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 14px;
            z-index: 10001;
            animation: bookmarkPop 0.3s ease;
        `;
        
        const style = document.createElement('style');
        style.textContent = `
            @keyframes bookmarkPop {
                0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
                50% { transform: translate(-50%, -50%) scale(1.1); }
                100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
            }
        `;
        document.head.appendChild(style);
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.style.opacity = '0';
            setTimeout(() => notification.remove(), 300);
        }, 1500);
    }
}

function initQuantitySelector() {
    const cartIcon = document.querySelector('.cart');
    
    if (cartIcon) {
        cartIcon.addEventListener('mouseenter', function() {
            this.style.transform = 'scale(1.02)';
            this.style.boxShadow = '0 4px 15px rgba(196, 30, 58, 0.2)';
        });
        
        cartIcon.addEventListener('mouseleave', function() {
            this.style.transform = 'scale(1)';
            this.style.boxShadow = 'none';
        });
    }
}

function initLoadingAnimation() {
    const body = document.body;
    
    const loader = document.createElement('div');
    loader.className = 'page-loader';
    loader.innerHTML = `
        <div class="loader-content">
            <div class="loader-icon">馃摎</div>
            <div class="loader-text">鍔犺浇涓?..</div>
        </div>
    `;
    
    loader.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #faf8f5 0%, #ffffff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        transition: opacity 0.5s ease, visibility 0.5s ease;
    `;
    
    const style = document.createElement('style');
    style.textContent = `
        .loader-content {
            text-align: center;
        }
        .loader-icon {
            font-size: 48px;
            margin-bottom: 15px;
            animation: bounce 1s ease infinite;
        }
        .loader-text {
            color: #636e72;
            font-size: 14px;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .page-loader.hidden {
            opacity: 0;
            visibility: hidden;
        }
    `;
    document.head.appendChild(style);
    document.body.insertBefore(loader, document.body.firstChild);
    
    window.addEventListener('load', function() {
        setTimeout(() => {
            loader.classList.add('hidden');
            setTimeout(() => loader.remove(), 500);
        }, 500);
    });
}

document.addEventListener('DOMContentLoaded', () => {
    
    // --------------------------------------------------------
    // 1. 导航栏滚动毛玻璃特效控制
    // --------------------------------------------------------
    const header = document.querySelector('.c-site-header');
    if (header) {
        window.addEventListener('scroll', () => {
            // 当页面向下滚动超过 50px 时添加类名
            if (window.scrollY > 50) {
                header.classList.add('is-scrolled');
            } else {
                header.classList.remove('is-scrolled');
            }
        }, { passive: true }); // passive 提升滚动性能
    }

    // --------------------------------------------------------
    // 2. 页面元素进入视窗自动淡入 (Scroll Reveal)
    // --------------------------------------------------------
    // 获取你在 HTML 中已经写好的含有 data-reveal 属性的元素
    const revealElements = document.querySelectorAll('[data-reveal]');
    
    const revealOptions = {
        root: null,
        rootMargin: '0px 0px -100px 0px', // 元素底部进入视窗上方 100px 时才触发，营造延迟感
        threshold: 0.1
    };

    const revealCallback = (entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
            }
        });
    };

    if (window.IntersectionObserver) {
        const revealObserver = new IntersectionObserver(revealCallback, revealOptions);
        revealElements.forEach(el => revealObserver.observe(el));
    }

    // --------------------------------------------------------
    // 3. (高阶) 原生 3D 跟随鼠标倾斜交互
    // --------------------------------------------------------
    // 找到需要 3D 效果的卡片，比如顶部的小卡片 .c-mini-card
    const tiltCards = document.querySelectorAll('.c-mini-card'); 
    
    tiltCards.forEach(card => {
        // 鼠标在卡片上移动时
        card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left; // 鼠标在卡片内的 X 坐标
            const y = e.clientY - rect.top;  // 鼠标在卡片内的 Y 坐标
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            // 计算倾斜角度 (数值 15 可调，数值越大倾斜越夸张)
            const rotateX = ((y - centerY) / centerY) * -15; 
            const rotateY = ((x - centerX) / centerX) * 15;

            card.style.transform = \perspective(1000px) rotateX(\deg) rotateY(\deg) scale3d(1.02, 1.02, 1.02)\;
        });

        // 鼠标移出时归位
        card.addEventListener('mouseleave', () => {
            card.style.transform = \perspective(1000px) rotateX(0) rotateY(0) scale3d(1, 1, 1)\;
            card.style.transition = 'transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        });
        
        // 鼠标刚进入时取消过渡，让跟随更丝滑
        card.addEventListener('mouseenter', () => {
             card.style.transition = 'none'; 
        });
    });
});

document.addEventListener('DOMContentLoaded', () => {
    // --------------------------------------------------------
    // 4. SPA级别丝滑页面跳转过渡 (拦截链接跳转)
    // --------------------------------------------------------
    // 选取所有站内链接 (指向 .html 或是相对路径的)
    const links = document.querySelectorAll('a[href\$=".html"], a[href^="./"]');
    
    links.forEach(link => {
        link.addEventListener('click', function(e) {
            // 如果是新标签页打开、锚点链接或是没有 href，不拦截
            if (this.target === '_blank' || 
                !this.getAttribute('href') || 
                this.getAttribute('href').startsWith('#') ||
                e.ctrlKey || e.metaKey) {
                return;
            }
            
            e.preventDefault();
            const destination = this.href;
            
            // 给 body 添加退出动画类
            document.body.classList.add('is-exiting');
            
            // 等待动画完成后再跳转 (400ms 必须与 CSS 中的过渡时间保持一致)
            setTimeout(() => {
                window.location.href = destination;
            }, 400);
        });
    });
});

// 引入 Lenis 平滑滚动库 (通过动态创建 script 标签引入，不需要 npm)
(function loadAdvancedEffects() {
    // 动态引入 Lenis JS 
    const lenisScript = document.createElement('script');
    lenisScript.src = 'https://unpkg.com/@studio-freight/lenis@1.0.39/dist/lenis.min.js';
    lenisScript.onload = initAdvancedEffects;
    document.head.appendChild(lenisScript);
})();

function initAdvancedEffects() {

    // ========================================================
    // 1. 初始化 Lenis 极致惯性平滑滚动
    // ========================================================
    const lenis = new Lenis({
        duration: 1.2,        // 滚动持续时间，控制丝滑程度
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // 苹果风的衰减曲线
        direction: 'vertical',
        gestureDirection: 'vertical',
        smooth: true,
        mouseMultiplier: 1,
        smoothTouch: false,   // 手机端保留原生滑动，体验更好
        touchMultiplier: 2,
    });

    // 每一帧更新滚动，同时触发其他需要滚动的动画
    function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    // ========================================================
    // 2. 视差滚动 (Parallax Effect)
    // ========================================================
    // 找到轮播图背景所在的元素
    const parallaxElements = document.querySelectorAll('.c-hero-banner__slide::before, .c-hero-banner__frame');
    
    lenis.on('scroll', (e) => {
        // e.scroll 是当前向下滚动的距离
        const scrollY = e.scroll;
        
        // 找到当前激活的 banner
        const activeSlide = document.querySelector('.c-hero-banner__slide.is-active');
        if (activeSlide) {
            // 给 slide 一个微弱的向下位移，速度比正常滚动慢（0.3倍速），产生纵深感
            activeSlide.style.transform = \	ranslateY(\px) scale(1)\;
        }
    });

    // ========================================================
    // 3. 定制化磁性光标 (Custom Magnetic Cursor)
    // ========================================================
    // 创建光标元素
    const cursorDot = document.createElement('div');
    cursorDot.className = 'c-cursor-dot';
    const cursorRing = document.createElement('div');
    cursorRing.className = 'c-cursor-ring';
    
    // 只在非触摸设备（电脑）上添加光标
    if (window.matchMedia("(pointer: fine)").matches) {
        document.body.appendChild(cursorDot);
        document.body.appendChild(cursorRing);

        let mouseX = 0;
        let mouseY = 0;
        let ringX = 0;
        let ringY = 0;

        // 监听鼠标移动
        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            
            // 主圆点没有延迟，死死贴着鼠标
            cursorDot.style.left = mouseX + 'px';
            cursorDot.style.top = mouseY + 'px';
        });

        // 用 requestAnimationFrame 让外圈产生带有阻尼的跟随延迟感
        const renderCursor = () => {
            // Lerp (线性插值) 算法，0.15是阻尼系数
            ringX += (mouseX - ringX) * 0.15;
            ringY += (mouseY - ringY) * 0.15;
            
            cursorRing.style.transform = \	ranslate(calc(-50% + \px), calc(-50% + \px))\;
            requestAnimationFrame(renderCursor);
        };
        requestAnimationFrame(renderCursor);

        // 监听可点击元素的悬停状态 (磁性吸附变形效果)
        const interactables = document.querySelectorAll('a, button, input, .c-mini-card, .content_item');
        
        interactables.forEach(el => {
            el.addEventListener('mouseenter', () => {
                cursorDot.classList.add('is-hovering');
                cursorRing.classList.add('is-hovering');
            });
            el.addEventListener('mouseleave', () => {
                cursorDot.classList.remove('is-hovering');
                cursorRing.classList.remove('is-hovering');
            });
        });
    }
}
